pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- oscillarium
-- analysis mode: component match

waves={
 {id=1,n="low",f=1,a=18,p=0,c=12},
 {id=2,n="high",f=3,a=10,p=0,c=8},
 {id=3,n="phase",f=2,a=12,p=.25,c=10},
 {id=4,n="wide",f=1,a=14,p=.5,c=11},
 {id=5,n="tiny4",f=4,a=7,p=.125,c=14},
 {id=6,n="slow2",f=2,a=18,p=.5,c=9},
 {id=7,n="fifth",f=5,a=6,p=0,c=13},
 {id=8,n="drift",f=1,a=10,p=.125,c=15}
}

puzzles={
 {name="wiggle",ans={1,2},say="welcome to the oscill-arium"},
 {name="phase",ans={3,5},say="please respect the sine waves"},
 {name="counter",ans={4,2},say="two waves enter. one leaves"},
 {name="mirror",ans={1,4},say="opposites make a polite wobble"},
 {name="ladder",ans={6,2},say="a rising exhibit for careful ears"},
 {name="spark",ans={5,7},say="small waves cause large paperwork"},
 {name="garden",ans={3,6},say="phase is how waves gossip"},
 {name="drift",ans={8,7},say="a quiet wave with a bright edge"}
}

mode="comp" -- comp | shell | top
shell=2 -- 1 top, 2 bottom
cur=1
pick={}
cursor=1
msg="analysis: pick components"
msg_t=0
wrong_t=0
right_t=0

function _init() cls() end

function _update60()
 if mode=="comp" then update_comp()
 elseif mode=="top" then update_top()
 else update_shell() end
 if msg_t>0 then msg_t-=1 end
 if wrong_t>0 then wrong_t-=1 end
 if right_t>0 then right_t-=1 end
end

function update_comp()
 local row=flr((cursor-1)/4)
 local col=(cursor-1)%4
 if btnp(0) then col=max(0,col-1) end
 if btnp(1) then col=min(3,col+1) end
 if btnp(2) then row=max(0,row-1) end
 if btnp(3) then row=min(1,row+1) end
 cursor=min(#waves,row*4+col+1)
 if btnp(4) then toggle_pick(cursor) end
 if btnp(5) then mode="shell" shell=2 msg="choose area" end
end

function update_top()
 if btnp(0) or btnp(2) then cur=wrap(cur-1,#puzzles) new_target() end
 if btnp(1) or btnp(3) then cur=wrap(cur+1,#puzzles) new_target() end
 if btnp(4) then sfx(10,3) msg="target "..cur.." selected" end
 if btnp(5) then mode="shell" shell=1 msg="choose area" end
end

function update_shell()
 if btnp(2) or btnp(3) then shell=3-shell end
 if btnp(0) or btnp(1) then shell=3-shell end
 if btnp(4) then
  mode=shell==1 and "top" or "comp"
  msg=shell==1 and "target focus" or "component focus"
 end
 if btnp(5) then mode="comp" shell=2 msg="component focus" end
end

function wrap(v,n)
 if v<1 then return n end
 if v>n then return 1 end
 return v
end

function new_target()
 pick={}
 wrong_t=0
 right_t=0
 msg="target "..cur..": "..puzzles[cur].name
 sfx(10,3)
end

function toggle_pick(i)
 for k=1,#pick do
  if pick[k]==i then
   deli(pick,k)
   msg="removed "..waves[i].n
   sfx(10,3)
   return
  end
 end
 if #pick>=2 then deli(pick,1) end
 add(pick,i)
 msg="selected "..waves[i].n
 audition(i)
 if #pick==2 then evaluate_pick() else play_pick() end
end

function audition(i)
 sfx(i-1,0)
 msg="audition "..waves[i].n
end

function play_pick()
 if #pick==2 then
  sfx(pick[1]-1,0)
  sfx(pick[2]-1,1)
 end
end

function evaluate_pick()
 if #pick<2 then msg="pick two waves" return end
 local a=puzzles[cur].ans
 if has_pick(a[1]) and has_pick(a[2]) then
  msg="correct. exhibit stable"
  right_t=90 wrong_t=0
  sfx(8,2)
  play_pick()
  msg_t=120
 else
  msg="wrong pair. display reset"
  pick={}
  wrong_t=70 right_t=0
  sfx(9,2)
  msg_t=90
 end
end

function next_puzzle()
 cur=cur%#puzzles+1
 pick={} cursor=1
 msg="new exhibit"
 wrong_t=0 right_t=0
 sfx(8,2)
end

function has_pick(i)
 for p in all(pick) do if p==i then return true end end
 return false
end

function val(w,t)
 return sin(t*w.f+w.p)*w.a
end

function combo(ids,t)
 local y=0
 for i in all(ids) do y+=val(waves[i],t) end
 return y/max(1,#ids)
end

function _draw()
 cls(1)
 print("oscillarium",34,3,7)
 print("analysis mode",31,10,10)
 draw_top()
 draw_components()
 draw_nav()
 draw_toast()
end

function draw_top()
 local p=puzzles[cur]
 local col= shell==1 and mode=="shell" and 6 or 5
 if mode=="top" then col=10 end
 if wrong_t>0 then col=8 end
 if right_t>0 then col=11 end
 rect(1,18,126,64,col)
 if wrong_t>0 and flr(wrong_t/6)%2==0 then rectfill(2,19,125,63,2) end
 if right_t>0 and flr(right_t/8)%2==0 then rectfill(2,19,125,63,3) end
 print("target "..cur.."/"..#puzzles.." "..p.name,4,20,7)
 draw_wave(p.ans,4,30,120,31,right_t>0 and 11 or 7)
end

function draw_components()
 local border=shell==2 and mode=="shell" and 6 or 5
 if mode=="comp" then border=10 end
 rect(1,67,126,115,border)
 print("components",4,68,6)
 for i=1,#waves do
  local x=4+((i-1)%4)*30
  local y=76+flr((i-1)/4)*18
  local col=waves[i].c
  if mode=="comp" and cursor==i then rect(x-2,y-2,x+25,y+15,10) end
  if has_pick(i) then rectfill(x-1,y-1,x+24,y+14,5) end
  print(waves[i].n,x,y,col)
  draw_wave({i},x,y+8,24,7,col)
 end
end

function draw_toast()
 if wrong_t>0 then
  rectfill(14,116,113,126,2)
  rect(15,117,112,125,8)
  print("wrong - reset",39,119,8)
 elseif right_t>0 then
  rectfill(14,116,113,126,3)
  rect(15,117,112,125,11)
  print("correct",50,119,11)
 else
  print(msg,4,123,msg_t>0 and 10 or 7)
 end
end

function draw_nav()
 if mode=="shell" then
  print("area:"..(shell==1 and "target" or "components").." z focus",4,117,6)
 elseif mode=="top" then
  print("target: arrows change x back",4,117,5)
 else
  print("components: arrows z pick x back",1,117,5)
 end
end

function draw_wave(ids,x,y,w,h,col)
 local lastx=x
 local lasty=y+h/2-combo(ids,0)*.6
 for px=1,w do
  local t=px/w
  local yy=y+h/2-combo(ids,t)*.6
  line(lastx,lasty,x+px,yy,col)
  lastx=x+px
  lasty=yy
 end
 line(x,y+h/2,x+w,y+h/2,5)
end
__sfx__
