pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- aggreculture
-- homestead sketch v1

run_seed=186

function _init()
 mode="seed_select"
end

function reset_farm()
 p={x=94,y=92,dx=0,dy=1}
 plots={}
 goal=5+flr(rnd(4))
 seeds=3+flr(rnd(3))
 harvest=0
 tick=0
 growth_rate=120+flr(rnd(5))*15
 spawn_base=260+flr(rnd(5))*20
 spawn_t=spawn_base
 blight_speed=.35+rnd(.2)
 crop_col=rnd(1)<.5 and 10 or 11
 crop_leaf=11
 swing_t=0
 active_tool=1
 z_hold=0
 z_ready=false
 msg="world "..seed_text().." is growing"
 msg_t=150
 for row=0,3 do
  for col=0,5 do
   add(plots,{x=10+col*11,y=24+row*11,s=0,age=0})
  end
 end
 generate_map()
 enter_room(1,1,94,92)
end

function start_overworld()
 srand(run_seed)
 reset_farm()
 mode="overworld"
 sfx(0)
end

function _update60()
 if mode=="seed_select" then
  update_seed_select()
  return
 end
 if mode=="tool_menu" then
  update_tool_menu()
  return
 end
 if mode=="win" then
  if btnp(4) or btnp(5) then
   mode="seed_select"
  end
  return
 end

 tick+=1
 if msg_t>0 then msg_t-=1 end
 if swing_t>0 then swing_t-=1 end
 update_player()
 update_crops()
 if wx==1 and wy==1 then
  update_pests()
  spawn_t-=1
  if spawn_t<=0 then
   spawn_blight()
   spawn_t=max(140,spawn_base-harvest*18)
  end
 end

 update_tool_input()
 if mode=="overworld" and btnp(5) then use_active_tool() end
end

function update_tool_input()
 if not z_ready then
  if not btn(4) then z_ready=true end
  return
 end
 if btn(4) then
  z_hold+=1
  if z_hold>=24 then
   mode="tool_menu"
   sfx(2)
  end
 elseif z_hold>0 then
  active_tool=3-active_tool
  z_hold=0
  say("x tool: "..tool_name())
  sfx(2)
 end
end

function update_tool_menu()
 if btnp(0) or btnp(2) then
  active_tool=1
  sfx(1)
 end
 if btnp(1) or btnp(3) then
  active_tool=2
  sfx(1)
 end
 if not btn(4) then
  mode="overworld"
  z_hold=0
  say("x tool: "..tool_name())
 end
end

function tool_name()
 return active_tool==1 and "hoe" or "farm"
end

function use_active_tool()
 if active_tool==1 then swing_hoe() else use_plot() end
end

function update_seed_select()
 local changed=false
 if btnp(0) then run_seed-=1 changed=true end
 if btnp(1) then run_seed+=1 changed=true end
 if btnp(2) then run_seed+=100 changed=true end
 if btnp(3) then run_seed-=100 changed=true end
 run_seed=(run_seed+10000)%10000
 if changed then sfx(1) end
 if btnp(5) then
  run_seed=flr(rnd(10000))
  sfx(2)
 end
 if btnp(4) then start_overworld() end
end

function seed_text()
 local s=tostr(run_seed)
 while #s<4 do s="0"..s end
 return s
end

function room_at(x,y)
 if x<0 or x>2 or y<0 or y>2 then return nil end
 return rooms[y*3+x+1]
end

function connect_rooms(x,y,dx,dy)
 local a=room_at(x,y)
 local b=room_at(x+dx,y+dy)
 if not a or not b then return end
 if dx==1 then a.exits.e=true b.exits.w=true end
 if dx==-1 then a.exits.w=true b.exits.e=true end
 if dy==1 then a.exits.s=true b.exits.n=true end
 if dy==-1 then a.exits.n=true b.exits.s=true end
end

function generate_map()
 rooms={}
 for y=0,2 do
  for x=0,2 do
   add(rooms,{
    x=x,y=y,
    biome=flr(rnd(3))+1,
    exits={n=false,e=false,s=false,w=false},
    obstacles={},supplies={},pests={},plots={},marks={}
   })
  end
 end
 room_at(1,1).biome=0

 -- every room gets a route toward the farm
 for y=0,2 do
  for x=0,2 do
   if x<1 then connect_rooms(x,y,1,0)
   elseif x>1 then connect_rooms(x,y,-1,0)
   elseif y<1 then connect_rooms(x,y,0,1)
   elseif y>1 then connect_rooms(x,y,0,-1) end
  end
 end

 -- the seed adds optional loops to the guaranteed routes
 for y=0,2 do
  for x=0,1 do
   if rnd(1)<.4 then connect_rooms(x,y,1,0) end
  end
 end
 for y=0,1 do
  for x=0,2 do
   if rnd(1)<.4 then connect_rooms(x,y,0,1) end
  end
 end

 for r in all(rooms) do generate_room(r) end
 room_at(1,1).plots=plots
end

function generate_room(r)
 local obstacle_count=r.biome==0 and 3 or 7+flr(rnd(5))
 local supply_count=r.biome==0 and 2 or 1+flr(rnd(3))
 for i=1,obstacle_count do
  local x,y=find_open_spot(r)
  add(r.obstacles,{x=x,y=y,k=flr(rnd(2))+1})
 end
 for i=1,supply_count do
  local x,y=find_open_spot(r)
  add(r.supplies,{x=x,y=y})
 end
end

function find_open_spot(r)
 for tries=1,40 do
  local x=8+flr(rnd(113))
  local y=22+flr(rnd(84))
  if open_spot(r,x,y) then return x,y end
 end
 return 60+rnd(12),100+rnd(8)
end

function open_spot(r,x,y)
 if r.biome==0 then
  if x<79 and y<78 then return false end
  if x>78 and y<64 then return false end
  if x<43 and y>86 then return false end
  if abs(x-94)+abs(y-92)<18 then return false end
 end
 if r.exits.n and y<30 and abs(x-64)<13 then return false end
 if r.exits.s and y>96 and abs(x-64)<13 then return false end
 if r.exits.w and x<24 and abs(y-64)<13 then return false end
 if r.exits.e and x>104 and abs(y-64)<13 then return false end
 for o in all(r.obstacles) do
  if abs(x-o.x)+abs(y-o.y)<11 then return false end
 end
 for s in all(r.supplies) do
  if abs(x-s.x)+abs(y-s.y)<9 then return false end
 end
 return true
end

function enter_room(x,y,px,py)
 wx=x wy=y
 local r=room_at(wx,wy)
 obstacles=r.obstacles
 supplies=r.supplies
 pests=r.pests
 plots=r.plots
 marks=r.marks
 p.x=px p.y=py
 if not (wx==1 and wy==1) then
  say(biome_name(r.biome).." "..(wx+1)..","..(wy+1))
 end
end

function biome_name(b)
 if b==1 then return "meadow" end
 if b==2 then return "grove" end
 return "stonewild"
end

function update_player()
 local mx=0
 local my=0
 if btn(0) then mx=-1 end
 if btn(1) then mx=1 end
 if btn(2) then my=-1 end
 if btn(3) then my=1 end

 if mx!=0 or my!=0 then
  if mx!=0 and my!=0 then mx*=.7 my*=.7 end
  local nx=p.x+mx
  local ny=p.y+my
  if not blocked(nx,p.y) then p.x=nx end
  if not blocked(p.x,ny) then p.y=ny end
  if abs(mx)>abs(my) then
   p.dx=sgn(mx) p.dy=0
  else
   p.dx=0 p.dy=sgn(my)
  end
  collect_supplies()
  try_travel()
 end
end

function blocked(x,y)
 local r=room_at(wx,wy)
 if x<2 and (not r.exits.w or abs(y-64)>10) then return true end
 if x>125 and (not r.exits.e or abs(y-64)>10) then return true end
 if y<16 and (not r.exits.n or abs(x-64)>10) then return true end
 if y>111 and (not r.exits.s or abs(x-64)>10) then return true end
 if r.biome==0 then
  if x>81 and y>18 and y<53 then return true end
  if x<42 and y>88 then return true end
 end
 for o in all(obstacles) do
  if abs(x-o.x)<5 and abs(y-o.y)<5 then return true end
 end
 return false
end

function try_travel()
 if p.x<0 then
  enter_room(wx-1,wy,123,p.y)
 elseif p.x>127 then
  enter_room(wx+1,wy,4,p.y)
 elseif p.y<13 then
  enter_room(wx,wy-1,p.x,108)
 elseif p.y>114 then
  enter_room(wx,wy+1,p.x,19)
 end
end

function collect_supplies()
 for i=#supplies,1,-1 do
  local s=supplies[i]
  if abs(p.x-s.x)+abs(p.y-s.y)<7 then
   deli(supplies,i)
   seeds+=1
   say("found a wild seed")
   sfx(4)
  end
 end
end

function plot_ahead()
 local fx=p.x+p.dx*7
 local fy=p.y+p.dy*7
 for q in all(plots) do
  if abs(q.x+4-fx)<7 and abs(q.y+4-fy)<7 then return q end
 end
end

function use_plot()
 local q=plot_ahead()
 if not q then
  say("face a garden plot")
  sfx(3)
  return
 end

 if q.s==0 then
  q.s=1
  say("soil tilled")
  sfx(1)
 elseif q.s==1 then
  if seeds<=0 then
   say("no seeds--harvest or defend")
   sfx(3)
  else
   q.s=2 q.age=0 seeds-=1
   say("seed planted")
   sfx(2)
  end
 elseif q.s==2 then
  say("still growing")
  sfx(3)
 else
 q.s=1 q.age=0
  harvest+=1 seeds+=2
  say("harvest! seeds returned")
  sfx(4)
  if harvest>=goal then
   mode="win"
   sfx(5)
  end
 end
end

function update_crops()
 if tick%growth_rate!=0 then return end
 for r in all(rooms) do
  for q in all(r.plots) do
   if q.s==2 then
    q.age+=1
    if q.age>=3 then q.s=3 end
   end
  end
 end
end

function any_crop()
 for q in all(plots) do
  if q.s>=2 then return true end
 end
 return false
end

function nearest_crop(e)
 local best=nil
 local bd=999
 for q in all(plots) do
  if q.s>=2 then
   local d=abs(e.x-q.x-4)+abs(e.y-q.y-4)
   if d<bd then bd=d best=q end
  end
 end
 return best
end

function spawn_blight()
 if #pests>=4 or not any_crop() then return end
 local side=flr(rnd(4))
 local e={x=2,y=16+rnd(108),step=0}
 if side==1 then e.x=125 end
 if side==2 then e.x=44+rnd(36) e.y=16 end
 if side==3 then e.x=44+rnd(36) e.y=125 end
 add(pests,e)
 say("a blight smells the field!")
 sfx(6)
end

function update_pests()
 if tick%3!=0 then return end
 for i=#pests,1,-1 do
  local e=pests[i]
  local q=nearest_crop(e)
  if q then
   local tx=q.x+4
   local ty=q.y+4
   if abs(e.x-tx)+abs(e.y-ty)<5 then
    q.s=1 q.age=0
    deli(pests,i)
    say("blight ate a crop")
    sfx(7)
   else
    if abs(tx-e.x)>1 then e.x+=sgn(tx-e.x)*blight_speed end
    if abs(ty-e.y)>1 then e.y+=sgn(ty-e.y)*blight_speed end
   end
  end
 end
end

function swing_hoe()
 swing_t=10
 local hx=p.x+p.dx*10
 local hy=p.y+p.dy*10
 local hit=false
 for i=#pests,1,-1 do
  local e=pests[i]
  if abs(e.x-hx)+abs(e.y-hy)<12 then
   deli(pests,i)
   seeds+=1
   hit=true
  end
 end
 if hit then
  say("blight cleared! +1 seed")
  sfx(4)
 else
  work_ground(hx,hy)
 end
end

function work_ground(hx,hy)
 local tx=flr(hx/9)*9
 local ty=flr(hy/9)*9
 if plot_near(tx,ty) then
  say("that soil is already farmable")
  sfx(3)
  return
 end
 if not terrain_can_till(tx,ty) then
  say("clear ground needed")
  sfx(3)
  return
 end

 local mark,mi=find_mark(tx,ty)
 if not mark then
  mark={x=tx,y=ty,h=0}
  add(marks,mark)
  mi=#marks
 end
 mark.h+=1
 local need=hoe_need(room_at(wx,wy).biome)
 if mark.h>=need then
  deli(marks,mi)
  add(plots,{x=tx,y=ty,s=1,age=0})
  say("new farm plot ready")
  sfx(4)
 else
  say("working soil "..mark.h.."/"..need)
  sfx(1)
 end
end

function hoe_need(b)
 if b==2 then return 3 end
 if b==3 then return 4 end
 return 2
end

function find_mark(x,y)
 for i=1,#marks do
  local m=marks[i]
  if m.x==x and m.y==y then return m,i end
 end
end

function plot_near(x,y)
 for q in all(plots) do
  if abs(q.x+4-x-4)<9 and abs(q.y+4-y-4)<9 then return q end
 end
end

function terrain_can_till(x,y)
 local r=room_at(wx,wy)
 local cx=x+4
 local cy=y+4
 if x<4 or x>116 or y<18 or y>101 then return false end
 if r.biome==0 then
  if x<79 and y<78 then return false end
  if x>77 and y<54 then return false end
  if cx<43 and cy>86 then return false end
 end
 if r.exits.n and y<30 and abs(cx-64)<13 then return false end
 if r.exits.s and y>96 and abs(cx-64)<13 then return false end
 if r.exits.w and x<24 and abs(cy-64)<13 then return false end
 if r.exits.e and x>104 and abs(cy-64)<13 then return false end
 for o in all(obstacles) do
  if abs(cx-o.x)+abs(cy-o.y)<11 then return false end
 end
 for s in all(supplies) do
  if abs(cx-s.x)+abs(cy-s.y)<9 then return false end
 end
 return true
end

function say(t)
 msg=t msg_t=120
end

function _draw()
 if mode=="seed_select" then
  draw_seed_select()
 elseif mode=="tool_menu" then
  draw_world()
  draw_tool_screen()
 elseif mode=="win" then
  draw_world()
  rectfill(15,43,112,86,1)
  rect(15,43,112,86,10)
  print("morning harvest!",33,50,11)
  print("the farm fights back.",25,62,7)
  print("z: choose a new world seed",13,75,6)
 else
  draw_world()
 end
end

function draw_seed_select()
 cls(3)
 for y=0,127,8 do
  for x=0,127,8 do
   if (x+y)%16==0 then pset(x,y,11) end
  end
 end
 print("world seed",44,8,11)
 print("the overworld grows from here",10,17,6)
 rectfill(24,31,103,59,1)
 rect(24,31,103,59,10)
 print("seed",55,36,5)
 print(seed_text(),56,47,10)
 print("same seed = same wild farm",14,67,7)
 print("generates 9 screens:",25,78,6)
 print("routes + biomes",32,87,5)
 print("obstacles + caches",27,95,5)
 print("farm + blight pressure",21,103,5)
 print("lr +/-1  ud +/-100",25,115,7)
 print("z grow  x random",34,122,10)
end

function draw_world()
 local r=room_at(wx,wy)
 local ground=ground_col(r.biome)
 local detail=detail_col(r.biome)
 cls(ground)
 -- grass texture
 for y=16,127,8 do
  for x=0,127,8 do
   pset(x+(y%3),y,detail)
  end
 end

 -- header
 rectfill(0,0,127,13,1)
 print("#"..seed_text(),2,4,6)
 print((wx+1)..","..(wy+1),27,4,7)
 print("bag:"..seeds,45,4,10)
 print("crop:"..harvest.."/"..goal,76,4,11)

 if r.biome==0 then
  -- pond
  ovalfill(-12,88,42,134,12)
  for y=95,122,8 do line(2,y,34,y,6) end

  -- farmhouse
  rectfill(82,24,123,51,4)
  rectfill(78,21,127,31,8)
  line(78,21,102,15,8)
  line(102,15,127,21,8)
  rectfill(98,37,108,51,9)
  rectfill(87,34,94,42,12)

  for x=5,76,9 do
   rectfill(x,70,x+1,75,4)
   line(x,72,x+8,72,4)
  end
 end

 for m in all(marks) do draw_mark(m) end
 for q in all(plots) do draw_plot(q) end
 draw_edges(r)
 for o in all(obstacles) do draw_obstacle(o) end
 for s in all(supplies) do draw_supply(s) end
 for e in all(pests) do draw_blight(e) end
 draw_farmer()

 if msg_t>0 then
  rectfill(2,115,125,126,1)
  print(msg,4,118,7)
 else
  print("x:"..tool_name().." z:cycle/hold",4,119,5)
 end
end

function draw_tool_screen()
 rectfill(12,25,115,101,1)
 rect(12,25,115,101,10)
 print("tool belt",46,31,7)

 draw_tool_card(18,43,59,78,1,"hoe")
 draw_tool_card(68,43,109,78,2,"farm")

 -- hoe icon
 line(29,54,45,70,10)
 line(26,55,32,49,6)
 line(25,54,31,60,6)
 -- farm icon
 rectfill(78,52,98,70,4)
 line(80,57,96,57,9)
 line(80,64,96,64,9)
 draw_crop(88,63,2,crop_col)

 print("hold z + arrows choose",22,86,6)
 print("release z: x uses "..tool_name(),16,94,7)
end

function draw_tool_card(x1,y1,x2,y2,id,name)
 local active=id==active_tool
 rectfill(x1,y1,x2,y2,active and 5 or 0)
 rect(x1,y1,x2,y2,active and 10 or 5)
 print(name,x1+12,y1+4,active and 10 or 6)
end

function ground_col(b)
 if b==1 then return 11 end
 if b==3 then return 5 end
 return 3
end

function detail_col(b)
 if b==1 then return 3 end
 if b==2 then return 1 end
 if b==3 then return 6 end
 return 11
end

function draw_edges(r)
 local c=r.biome==3 and 6 or 3
 if r.exits.n then
  rectfill(0,14,52,16,c) rectfill(76,14,127,16,c)
 else rectfill(0,14,127,16,c) end
 if r.exits.s then
  rectfill(0,110,52,113,c) rectfill(76,110,127,113,c)
 else rectfill(0,110,127,113,c) end
 if r.exits.w then
  rectfill(0,17,2,52,c) rectfill(0,76,2,109,c)
 else rectfill(0,17,2,109,c) end
 if r.exits.e then
  rectfill(125,17,127,52,c) rectfill(125,76,127,109,c)
 else rectfill(125,17,127,109,c) end
end

function draw_plot(q)
 rectfill(q.x,q.y,q.x+8,q.y+8,q.s==0 and 11 or 4)
 if q.s>0 then
  line(q.x+1,q.y+2,q.x+7,q.y+2,9)
  line(q.x+1,q.y+5,q.x+7,q.y+5,9)
 end
 if q.s==2 then draw_crop(q.x+4,q.y+5,q.age,crop_col) end
 if q.s==3 then draw_crop(q.x+4,q.y+5,3,crop_col) end
end

function draw_mark(m)
 rectfill(m.x,m.y,m.x+8,m.y+8,4)
 rect(m.x,m.y,m.x+8,m.y+8,9)
 for i=1,m.h do
  local yy=m.y+1+i*2
  line(m.x+1,yy,m.x+7,yy,5)
 end
end

function draw_crop(x,y,age,col)
 local h=1+age*2
 line(x,y,x,y-h,col)
 if age>1 then
  pset(x-1,y-h+1,crop_leaf)
  pset(x+1,y-h+2,crop_leaf)
 end
 if age>=3 then circfill(x,y-h,2,col) end
end

function draw_obstacle(o)
 if o.k==1 then
  circfill(o.x,o.y,4,5)
  line(o.x-2,o.y-2,o.x+2,o.y+2,6)
 else
  rectfill(o.x-1,o.y,o.x+1,o.y+5,4)
  circfill(o.x,o.y-3,5,3)
  circfill(o.x-2,o.y-4,3,11)
 end
end

function draw_supply(s)
 rectfill(s.x-2,s.y-2,s.x+2,s.y+2,4)
 rect(s.x-2,s.y-2,s.x+2,s.y+2,10)
 pset(s.x,s.y,11)
end

function draw_farmer()
 local x=flr(p.x)
 local y=flr(p.y)
 circfill(x,y-2,3,15)
 rectfill(x-2,y+1,x+2,y+5,2)
 pset(x+p.dx*2,y-2+p.dy*2,1)
 if swing_t>0 then
  local hx=x+p.dx*8
  local hy=y+p.dy*8
  line(x+p.dx*3,y+p.dy*3,hx,hy,10)
  circ(hx,hy,2,10)
 end
end

function draw_blight(e)
 local x=flr(e.x)
 local y=flr(e.y)
 circfill(x,y,3,2)
 pset(x-1,y-1,8)
 pset(x+1,y-1,8)
 line(x-3,y-3,x-5,y-5,8)
 line(x+3,y-3,x+5,y-5,8)
end

__label__
b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333b3333333
33333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333
33333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333
33333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333
33333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333
33333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333
